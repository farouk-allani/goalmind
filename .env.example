# GoalMind — Environment Setup

# Expo
EXPO_PUBLIC_APP_NAME=GoalMind
EXPO_PUBLIC_APP_VERSION=1.0.0

# QVAC SDK (On-Device AI)
# No API keys required — all inference runs locally

# WDK (Self-Custodial Wallet)
# No API keys required — wallet is self-custodial

# Development
NODE_ENV=development
EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0

# Build
EAS_BUILD_PLATFORM=ios
EAS_BUILD_PROFILE=development

# Analytics (optional)
# EXPO_PUBLIC_ANALYTICS_ID=

# Sentry (optional)
# EXPO_PUBLIC_SENTRY_DSN=
