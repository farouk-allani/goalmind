# GoalMind Environment Variables
# Copy this to .env and fill in your values.

# Football Data API (optional — app works with sample data without it)
# Get a free key at: https://www.football-data.org/client/register
EXPO_PUBLIC_FOOTBALL_API_KEY=

# API-Football / api-sports.io (optional — adds REAL live in-play statistics:
# possession, shots, pass accuracy — for matches currently being played)
# Get a free key at: https://www.api-football.com/
EXPO_PUBLIC_API_FOOTBALL_KEY=


# Blockchain RPC URLs (optional — uses public RPCs by default)
# For better reliability, get free keys from:
# - Infura: https://infura.io
# - Alchemy: https://alchemy.com
EXPO_PUBLIC_ETHEREUM_RPC_URL=https://eth.llamarpc.com
EXPO_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
EXPO_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
EXPO_PUBLIC_OPTIMISM_RPC_URL=https://mainnet.optimism.io

# App Configuration
EXPO_PUBLIC_APP_NAME=GoalMind
EXPO_PUBLIC_APP_VERSION=1.0.0
