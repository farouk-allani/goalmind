# Network resilience — survives ECONNRESET / dropped connections on slow or
# unstable links when downloading the large RN / Expo / wallet-SDK tree.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

# Fewer parallel sockets = far fewer resets on unstable Wi-Fi/mobile networks.
# Slightly slower, but much more reliable than npm's default concurrency.
maxsockets=3

# Pin the public registry (guards against a stray proxy/registry override).
registry=https://registry.npmjs.org/

# Skip the extra post-install audit/fund network calls (faster, less to fail on).
audit=false
fund=false
