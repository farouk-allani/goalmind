{
  "expo": {
    "name": "GoalMind",
    "slug": "goalmind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "goalmind",
    "splash": {
      "image": "./assets/brand/splash.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#0F1113",
      "dark": {
        "image": "./assets/brand/splash.jpg",
        "resizeMode": "cover",
        "backgroundColor": "#0F1113"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goalmind.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GoalMind needs camera access to analyze live football matches",
        "NSMicrophoneUsageDescription": "GoalMind needs microphone access for voice commentary"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1113"
      },
      "package": "com.goalmind.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "navigationBar": {
        "backgroundColor": "#17191C",
        "barStyle": "dark-content"
      }
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "edgeToEdgeEnabled": true
          }
        }
      ],
      "@qvac/sdk/expo-plugin",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
