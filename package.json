{
  "name": "goalmind",
  "version": "1.0.0",
  "description": "GoalMind — On-device AI football companion for the Tether Developers Cup. QVAC + WDK. Stadium-ready, private, premium.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "qvac:bundle:android": "bare-pack --host android-arm64 --linked --imports node_modules/@qvac/sdk/bare-imports.json --defer expo-file-system --defer react-native-bare-kit --out qvac/worker.android.bundle.js qvac/worker.entry.mjs && node -e \"require('fs').copyFileSync('qvac/worker.android.bundle.js','node_modules/@qvac/sdk/dist/worker.mobile.bundle.js'); console.log('Android-only QVAC worker bundle installed')\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@qvac/sdk": "^0.14.1",
    "@tetherto/wdk": "^1.0.0-beta.12",
    "@tetherto/wdk-wallet-evm": "^1.0.0-beta.14",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.0",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.9",
    "expo-camera": "~17.0.0",
    "expo-constants": "~18.0.0",
    "expo-device": "~8.0.0",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-image": "~3.0.0",
    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "nativewind": "^4.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.14.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "sodium-javascript": "^0.8.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.1.0",
    "bare-pack": "^2.0.2",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
